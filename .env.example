# Copy to .env and change EVERY secret. Never commit .env.
POSTGRES_PASSWORD=change-me-strong
JWT_SECRET=change-me-with-openssl-rand-hex-32
MINIO_ROOT_USER=nexusminio
MINIO_ROOT_PASSWORD=change-me-strong-minio

# LLM gateway (LiteLLM). Leave keys blank to run in offline demo mode.
LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

ALLOWED_ORIGINS=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
DEMO_ADMIN_PASSWORD=change-me-demo-login
