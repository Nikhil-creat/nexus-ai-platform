# Copy to .env.local for local dev. In production set these in Vercel -> Settings -> Environment Variables.
# Never commit real values. Never prefix secrets with NEXT_PUBLIC_.
SESSION_SECRET=            # openssl rand -hex 32
ADMIN_EMAIL=you@example.com
ALLOW_SIGNUP=true          # set false once your account exists
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=  GEMINI_MODEL=  LLM_PROVIDER=groq|gemini
# LLM_BASE_URL=  LLM_API_KEY=  LLM_MODEL=
# Persistence (auto-added by Vercel's Upstash integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SITE_URL=
